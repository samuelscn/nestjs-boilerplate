{
  "name": "nestjs-modular-boilerplate",
  "private": true,
  "version": "1.0.0",
  "description": "Boilerplate para APIs NestJS modulares com TypeORM e PostgreSQL",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write \"{src,jest,scripts}/**/*.{ts,js,mjs}\" \"*.{json,md,yml,yaml}\" \"docs/**/*.md\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "openapi:export": "NODE_ENV=test IDENTITY_PROVIDER=fake AUTHORIZATION_MODE=single DATABASE_HOST=localhost DATABASE_USERNAME=openapi DATABASE_PASSWORD= DATABASE_NAME=openapi PROBLEM_TYPE_BASE= node -r ts-node/register -r tsconfig-paths/register src/openapi-export.ts",
    "openapi:check": "npm run openapi:export && git diff --exit-code -- contracts/openapi.json",
    "lint": "npm run lint:code && npm run lint:structure",
    "lint:code": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:structure": "node scripts/check-structure.mjs",
    "test": "npm run test:unit",
    "test:unit": "jest --config ./jest/jest.unit.config.js",
    "test:integration": "node node_modules/jest/bin/jest.js --config ./jest/jest.integration.config.js",
    "test:e2e": "node node_modules/jest/bin/jest.js --config ./jest/jest.e2e.config.js",
    "test:watch": "jest --config ./jest/jest.unit.config.js --watch",
    "test:cov": "jest --config ./jest/jest.unit.config.js --coverage",
    "security:audit": "npm audit --audit-level=low",
    "migration:generate": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:generate src/package/example/persistence/migration/ExampleSchema -d src/package/example/persistence/example.datasource.ts",
    "migration:run": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d src/package/example/persistence/example.datasource.ts",
    "migration:revert": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d src/package/example/persistence/example.datasource.ts",
    "migration:access:generate": "node scripts/access-migration.mjs generate",
    "migration:access:run": "node scripts/access-migration.mjs run",
    "migration:access:revert": "node scripts/access-migration.mjs revert",
    "database:access:grant": "node scripts/access-grants.mjs",
    "check": "npm run lint && npm run build && npm run test:unit",
    "prepare": "husky"
  },
  "engines": {
    "npm": ">=11.0.0",
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@nestjs/common": "11.1.19",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.1",
    "jose": "^6.2.12",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "11.1.19",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "overrides": {
    "multer": "^2.3.0"
  }
}
