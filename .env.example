NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=debug
LOG_RULES=context=*;level=debug
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=ginga_app
DATABASE_PASSWORD=ginga_app_dev
# Migration role used only by `npm run db:migrate` (and the deploy preDeployCommand).
MIGRATION_DATABASE_USERNAME=ginga_migrator
MIGRATION_DATABASE_PASSWORD=ginga_migrator_dev
DATABASE_NAME=nestjs_boilerplate
AUTHORIZATION_MODE=single
IDENTITY_PROVIDER=fake
# For Ginga Identity: IDENTITY_PROVIDER=oidc (required in production).
OIDC_ISSUER=http://localhost:4000/api/auth
# Must match the resource requested by the BFF and registered in OAUTH_RESOURCES.
OIDC_AUDIENCE=http://localhost:3000
# RFC 9457 `type` prefix; must end with / (https) or : (urn).
# PROBLEM_TYPE_BASE=urn:ginga:problem:
# Feature flags (registry: src/feature-flags.ts); unknown names fail at boot.
# FEATURE_FLAGS=memberInvitations=true
