  "info": {
    "title": "Ginga Product API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "Permission": {
        "type": "string",
        "enum": [
          "role:read",
          "role:create",
          "role:update",
          "role:delete",
          "role:assign",
          "member:read",
          "member:invite",
          "member:update",
          "member:remove",
          "example:read",
          "example:create"
        ]
      },
      "RoleResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "isSystem": {
            "type": "boolean"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "description",
          "isSystem",
          "permissions",
          "createdAt",
          "updatedAt"
        ]
      },
      "RoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        },
        "required": [
          "name",
          "slug",
          "permissions"
        ]
      },
      "MemberResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "identityUserId": {
            "type": "string"
          },
          "roleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "id",
          "identityUserId",
          "roleIds"
        ]
      },
      "MemberDto": {
        "type": "object",
        "properties": {
          "identityUserId": {
            "type": "string",
            "description": "`sub` of the user in the identity provider."
          }
        },
        "required": [
          "identityUserId"
        ]
      },
      "CreateExampleItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      },
      "ExampleItemResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "createdAt"
        ]
      },
      "ProblemCode": {
        "type": "string",
        "description": "Stable problem identity. Clients decide and translate by this value; unknown values fall back to the generic message of the status.",
        "enum": [
          "VALIDATION_ERROR",
          "AUTHENTICATION_REQUIRED",
          "AUTHORIZATION_FORBIDDEN",
          "RESOURCE_NOT_FOUND",
          "RESOURCE_CONFLICT",
          "DOMAIN_RULE_VIOLATION",
          "RATE_LIMIT_EXCEEDED",
          "SERVICE_UNAVAILABLE",
          "INTERNAL_SERVER_ERROR",
          "METHOD_NOT_ALLOWED",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "SYSTEM_ROLE_IMMUTABLE",
          "LAST_OWNER_REQUIRED"
        ]
      },
      "FieldProblemCode": {
        "type": "string",
        "description": "Validation code derived from the class-validator constraint (isEmail → IS_EMAIL). Listed values are the documented ones; others may appear.",
        "enum": [
          "IS_NOT_EMPTY",
          "IS_EMAIL",
          "IS_UUID",
          "MIN_LENGTH",
          "MAX_LENGTH",
          "UNKNOWN_FIELD",
          "INVALID_VALUE"
        ]
      },
      "ProblemParams": {
        "type": "object",
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "FieldProblem": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "field": {
            "type": "string",
            "example": "items[0].name"
          },
          "code": {
            "type": "string",
            "example": "IS_NOT_EMPTY"
          },
          "params": {
            "$ref": "#/components/schemas/ProblemParams"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 9457 Problem Details with Ginga extensions (code, params, errors, traceId, timestamp).",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "traceId",
          "timestamp"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "description": "Developer-facing; never shown to users."
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "See ProblemCode."
          },
          "params": {
            "$ref": "#/components/schemas/ProblemParams"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldProblem"
            }
          },
          "traceId": {
            "type": "string",
            "description": "Equals the x-correlation-id header."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
